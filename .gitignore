# =============================================================================
# vcb2verilog .gitignore
# =============================================================================

# Build directories & CMake artifacts
build/
bin/
obj/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Compiled binaries and libraries
vcb2verilog
openvcb
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Simulation outputs (Icarus Verilog, GTKWave, ModelSim)
*.vcd
*.out

# FPGA synthesis & PnR artifacts (Yosys, nextpnr, IceStorm)
*.json
*.asc
*.bin
*.rpt
*.bit

# Generated Verilog output files (preserve sample files in examples/)
*.v
!examples/*.v

# Temporary and log files
*.log
*.tmp
vmemDump.txt

# Editor & OS metadata
.vscode/
.idea/
*.swp
*~
.DS_Store
